@{
    ViewData["Title"] = "Search CRIB";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Page Title -->
<div class="row">
    <div class="col-12">
        <div class="page-title-box">
            <h4 class="page-title">Search CRIB</h4>
        </div>
    </div>
</div>

<!-- Content -->
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">

                <!-- Search Type -->
                <div class="row">
                    <div class="col-7">
                        <label class="form-label">Search Type</label>

                        <div class="btn-group w-100" role="group">
                            <input type="radio" class="btn-check" name="tabs" id="IndividualSearch" checked>
                            <label class="btn btn-outline-info" for="IndividualSearch">Individual Search</label>

                            <input type="radio" class="btn-check" name="tabs" id="CompanySearch">
                            <label class="btn btn-outline-info" for="CompanySearch">Company Search</label>
                        </div>
                    </div>
                </div>

                <!-- Inputs -->
                <div class="row" style="margin-top:3%;">

                    <!-- Number Type + Gender / Company -->
                    <div class="col-sm-3">
                        <div id="NumberTypeDiv">
                            <label class="form-label mt-2">
                                Number Type <span style="color: red;">*</span>
                            </label>
                            <select id="NumberType" class="form-select">
                                <option></option>
                                <option value="NIC">NIC</option>
                                <option value="Passport">Passport</option>
                                <option value="NationalID">NationalID</option>
                            </select>
                        </div>

                        <!-- Gender -->
                        <div id="GenderDiv">
                            <label class="form-label mt-2">
                                Gender <span style="color: red;">*</span>
                            </label>
                            <select id="Gender" class="form-select">
                                <option></option>
                                <option value="male">Male</option>
                                <option value="female">Female</option>
                            </select>
                        </div>


                        <!-- Company Name -->
                        <div id="CompanyNameDiv" style="display:none;">
                            <label class="form-label mt-2">
                                Company Name <span style="color: red;">*</span>
                            </label>
                            <input type="text" id="CompanyNameInput" class="form-control">
                        </div>
                    </div>

                    <!-- Number + Full Name -->
                    <div class="col-sm-4">
                        <label class="form-label mt-2">
                            Number <span style="color: red;">*</span>
                        </label>
                        <input type="text" id="Number" class="form-control">
                        <div id="FullNameDiv">
                            <label class="form-label mt-2">
                                Full Name <span style="color: red;">*</span>
                            </label>
                            <input type="text" id="FullNameInput" class="form-control">
                        </div>
                    </div>

                </div>
                <div class="row" style="margin-top:20px;">
                    <div class="col-md-6" id="InquiryReasonDiv">
                        <label class="form-label mt-2">
                            Reason of Inquiry <span style="color: red;">*</span>
                        </label>
                        <select id="InquiryReason" class="form-select">
                            <option></option>
                            <option value="1">EvaluatingOfABorrowerForANewCreditFacility</option>
                            <option value="2">ReviewAsAGuarantorForANewCreditFacility</option>
                            <option value="3">MonitoringAndReviewingOfAnExistingBorrower</option>
                            <option value="4">OpeningOfACurrentAccount</option>
                            <option value="5">ReviewAsAPartnerOrProprietorForANewCreditFacility</option>
                            <option value="6">ReviewAsADirectorForANewCreditFacility</option>
                        </select>
                    </div>
                </div>

                <!-- Interactive Search Switch -->
                <div class="row" style="margin-top:20px;">
                    <div class="col-md-4">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="InterActiveSearch">
                            <label class="form-check-label" for="InterActiveSearch">
                                Activate Interactive Search
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Consent Switch -->
                <div class="row" style="margin-top:20px;">
                    <div class="col-md-4">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="ConsentSwitch">
                            <label class="form-check-label" for="ConsentSwitch">
                                I confirm that customer consent has been obtained
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Search Button -->
                <div class="row" style="margin-top:20px;">
                    <div class="col-12 text-start">
                        <button class="btn btn-dark" id="SearchBtn">
                            <span class="dripicons-search"></span> Search
                        </button>
                    </div>
                </div>

                <hr style="border:none; height:2px; background:linear-gradient(to right, transparent, #0d6efd, transparent);">

                <!-- Result Section -->
                <div class="row" style="margin-top:5%;">

                    <div class="col-lg-6">
                        <p class="mb-1 fw-bold text-muted">Application Number :</p>
                        <p class="text-muted font-14" id="AppNo"></p>
                    </div>

                    <div class="col-lg-6">
                        <p class="mb-1 fw-bold text-muted">Full Name :</p>
                        <p class="text-muted font-14" id="ResultFullName"></p>
                    </div>

                    <div class="col-lg-6">
                        <p class="mb-1 fw-bold text-muted">Credit Facility Type :</p>
                        <p class="text-muted font-14" id="FacilityType"></p>
                    </div>

                    <div class="col-lg-6">
                        <p class="mb-1 fw-bold text-muted">Credit Facility Amount :</p>
                        <p class="text-muted font-14" id="Amount"></p>
                    </div>

                </div>

                <!-- Download -->
                <div class="row" style="margin-top:5%;">
                    <div class="col-lg-6">
                        <button class="btn btn-info">
                            <span class="dripicons-arrow-down"></span> Download Report
                        </button>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<script src="~/assets/lib/jquery/dist/jquery.min.js"></script>
<script src="~/assets/js/sweetalert2.all.min.js"></script>
<script src="~/assets/js/select2/js/select2.min.js"></script>

<script>
    $(document).ready(function () {

        $("#Gender").select2({
            placeholder: "Select Gender",
            allowClear: true,
            width: '100%'
        });

        $("#InquiryReason").select2({
            placeholder: "Select Reason",
            allowClear: true,
            width: '100%'
        });

        $("#NumberType").select2({
            placeholder: "Select Number Type",
            allowClear: true,
            width: '100%'
        });

        function changeNumberType() {
            var select = $("#NumberType");

            if (select.hasClass("select2-hidden-accessible")) {
                select.select2('destroy');
            }

            if ($("#IndividualSearch").is(":checked")) {
                select.html(`
                    <option></option>
                    <option value="NIC">NIC</option>
                    <option value="Passport">Passport</option>
                `);
            } else {
                select.html(`
                    <option></option>
                    <option value="BRN">Business Registration Number</option>
                `);
            }

            select.select2({
                placeholder: "Select Number Type",
                allowClear: true,
                width: '100%'
            });
        }

    function toggleSearchMode() {
        var isIndividual = $("#IndividualSearch").is(":checked");

        if (isIndividual) {
            $("#FullNameDiv").show();
            $("#GenderDiv").show();
            $("#CompanyNameDiv").hide();
            $("#CompanyNameInput").val("");
        } else {
            $("#FullNameDiv").hide();
            $("#GenderDiv").hide();
            $("#CompanyNameDiv").show();
            $("#FullNameInput").val("");
            $("#Gender").val(null).trigger("change"); 
        }

        $("#Number").val("");
        $("#NumberType").val(null).trigger("change"); 
        $("#InquiryReason").val(null).trigger("change"); 
        $("#ConsentSwitch").prop("checked", false);
        $("#InterActiveSearch").prop("checked", false);
    }

    $("input[name='tabs']").on("change", function () {
        changeNumberType();
        toggleSearchMode();
    });

        // changeNumberType();
        // toggleSearchMode();

    $("#SearchBtn").click(function () {

        var numberType = $("#NumberType").val();
        var number = $("#Number").val();
        var isIndividual = $("#IndividualSearch").is(":checked");
        var consentGiven = $("#ConsentSwitch").is(":checked");
        var interactiveSearch = $("#InterActiveSearch").is(":checked");

        var fullName = isIndividual ? $("#FullNameInput").val() : "";
        var gender = isIndividual ? $("#Gender").val() : "";
        var companyName = !isIndividual ? $("#CompanyNameInput").val() : "";

        var inquiryReason = $("#InquiryReason").val();

        let title = "";
        let message = "";

        if (!numberType) {
            title = "Number Type Required";
            message = "Please enter Number Type";
        }
        else if (!number) {
            title = "Number Required";
            message = "Please enter the Number";
        }
        else if (isIndividual && !fullName) {
            title = "Full Name Required";
            message = "Please enter the Name";
        }
        else if (isIndividual && !gender) {
            title = "Gender Required";
            message = "Please enter the gender";
        }
        else if (!isIndividual && !companyName) {
            title = "Company Name Required";
            message = "Please enter Company Name";
        }
        else if (!inquiryReason) {
            title = "Inquiry Reason Required";
            message = "Please enter Inquiry Reason";
        }

        if (title) {
            Swal.fire({
                icon: 'warning',
                title: title,
                text: message,
                confirmButtonColor: '#3085d6'
            });
            return;
        }

        if (!consentGiven) {

            if (!interactiveSearch) {
                Swal.fire({
                    icon: 'warning',
                    title: "Interactive Search Required",
                    text: "Please enable Interactive Search to proceed",
                    confirmButtonColor: '#3085d6'
                });
                return;
            }
        }

        $.ajax({
            url: '/SearchCRIB/SearchData',
            type: 'POST',
            data: {
                numberType,
                number,
                fullName,
                gender,
                companyName,
                consentGiven,
                isIndividual,
                inquiryReason,
                interactiveSearch
            },
            success: function (res) {

                $("#AppNo").text(res.applicationNumber);
                $("#ResultFullName").text(res.fullName || res.companyName);
                $("#FacilityType").text(res.creditFacilityType);

                if (res.creditFacilityAmount) {
                    $("#Amount").text(
                        res.creditFacilityAmount.currency + " " +
                        res.creditFacilityAmount.value
                    );
                }
            },
            error: function () {
                Swal.fire({
                    icon: 'error',
                    title: "API Error",
                    text: "Please contact system admin",
                    confirmButtonColor: '#3085d6'
                });
            }
        });

    });

});
</script>